---
const date = new Date('2027-02-13T19:00:00-05:00');
const mapEmbed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.1874281371925!2d-75.6053108255622!3d6.239010493749272!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e442906b83c3313%3A0xd8e3ab8bedf36ef!2ssan%20angelo%20zafiro%20%7C%20banquete%20san%20angelo%20%7Cbanquetes%20medellin%20%7Csalon%20de%20eventos%20medellin!5e0!3m2!1ses-419!2sco!4v1787969113878!5m2!1ses-419!2sco';
const mapUrl = 'https://maps.app.goo.gl/K4bFehXACxzib5Te6';
const message = encodeURIComponent('Hola, soy [Tu nombre]. Confirmo mi asistencia a los XV años de Danna Stefania.');
const phoneNumbers = ['573014610039'];
const photos = [
  { src: '/photos/1.jpg', alt: 'Foto 1' },
  { src: '/photos/2.jpg', alt: 'Foto 2' },
  { src: '/photos/3.jpg', alt: 'Foto 3' },
  { src: '/photos/4.jpg', alt: 'Foto 4' },
  { src: '/photos/5.jpg', alt: 'Foto 5' },
  { src: '/photos/6.jpg', alt: 'Foto 6' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0d1f3c" />
    <title>Mis XV · Danna Stefania</title>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="bf-gold-grad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#f4e3c0" />
          <stop offset="45%" stop-color="#e6bd83" />
          <stop offset="100%" stop-color="#c89a4a" />
        </linearGradient>
        <linearGradient id="bf-blue-grad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#9cc3ea" />
          <stop offset="55%" stop-color="#5d87b8" />
          <stop offset="100%" stop-color="#274b7a" />
        </linearGradient>
      </defs>
    </svg>
    <main>
      <section class="cover">
        <div class="cover-art" aria-hidden="true"></div>

        <!-- 🦋 Mariposas volando: doradas y azules -->
        <div class="bf-field" data-butterfly-zone="cover" aria-hidden="true">
          <span class="bf bf-gold bf-a" style="--x:6%;--y:18%;--s:44px;--dur:5s;--delay:0s"></span>
          <span class="bf bf-blue bf-b" style="--x:16%;--y:64%;--s:52px;--dur:6s;--delay:1.2s"></span>
          <span class="bf bf-gold bf-c" style="--x:28%;--y:12%;--s:38px;--dur:5s;--delay:2.4s"></span>
          <span class="bf bf-blue bf-d" style="--x:38%;--y:52%;--s:30px;--dur:6s;--delay:0.6s"></span>
          <span class="bf bf-gold bf-b" style="--x:52%;--y:26%;--s:56px;--dur:7s;--delay:3s"></span>
          <span class="bf bf-blue bf-a" style="--x:62%;--y:70%;--s:46px;--dur:5s;--delay:1.8s"></span>
          <span class="bf bf-gold bf-d" style="--x:74%;--y:14%;--s:34px;--dur:6s;--delay:4.2s"></span>
          <span class="bf bf-blue bf-c" style="--x:84%;--y:44%;--s:42px;--dur:6s;--delay:2.1s"></span>
          <span class="bf bf-gold bf-a" style="--x:90%;--y:76%;--s:30px;--dur:5s;--delay:5s"></span>
        </div>

        <div class="cover-copy">
          <p class="eyebrow">Una noche de ensueño</p>
          <p class="small-title">Mis</p>
          <h1>XV</h1>
          <p class="name">Danna Stefania</p>
          <p class="date">13 · 02 · 2027</p>
          <p class="cover-dedication" data-guest-dedication hidden></p>
          <a class="scroll-arrow" href="#historia" aria-label="Continuar a la invitación">↓</a>
        </div>
      </section>

      <section class="story section" id="historia">
        <p class="eyebrow">Una nueva etapa</p>

        <div class="invite">
          <p class="invite-family">La familia Gutiérrez</p>
          <p class="invite-cta">te invita a celebrar los XV años de</p>
          <p class="invite-hero">Danna Stefania</p>
        </div>

        <h2 class="story-heading">Hay sueños que<br />alzan vuelo y<br /><em>se quedan para siempre.</em></h2>

        <div class="copy invite-copy">
          <p class="letter-salutation" data-guest-salutation hidden></p>
          <p>Quince años, una mariposa que despliega sus alas y una noche que brillará para siempre. Quiero compartir contigo la magia de este momento tan especial.</p>
          <p>Con mucha ilusión, te espero para compartir en esta celebración inolvidable.</p>
          <p class="signature">Con cariño,<br /><strong>Danna Stefania</strong></p>
        </div>

        <div class="bf-field bf-field-quiet" data-butterfly-zone="story" aria-hidden="true">
          <span class="bf bf-gold bf-d" style="--x:8%;--y:55%;--s:30px;--dur:6s;--delay:0s"></span>
          <span class="bf bf-blue bf-a" style="--x:88%;--y:30%;--s:34px;--dur:5s;--delay:1.5s"></span>
        </div>
      </section>

      <section class="event section">
        <div class="bf-field bf-field-quiet" data-butterfly-zone="event" aria-hidden="true">
          <span class="bf bf-gold bf-a"></span>
          <span class="bf bf-blue bf-c"></span>
        </div>
        <p class="eyebrow">Guarda la fecha</p>
        <div class="event-card">
          <div><span class="label">Sábado</span><strong class="date-display"><b>13</b><span>febrero<br /><small>2027</small></span></strong></div>
          <div><span class="label">Recepción</span><strong>7:00<br /><small>p. m.</small></strong></div>
        </div>
        <div class="countdown" data-countdown data-target={date.toISOString()}><div><b data-days>00</b><span>días</span></div><div><b data-hours>00</b><span>horas</span></div><div><b data-minutes>00</b><span>minutos</span></div><div><b data-seconds>00</b><span>segundos</span></div></div>
        <p class="punctual">Te esperamos con puntualidad para disfrutar desde el inicio de la fiesta y compartir más tiempo juntos.</p>
      </section>

      <section class="venue section">
        <div class="bf-field bf-field-quiet" data-butterfly-zone="venue" aria-hidden="true">
          <span class="bf bf-blue bf-b"></span>
          <span class="bf bf-gold bf-d"></span>
        </div>
        <div class="venue-photo"><iframe title="Ubicación de la recepción" src={mapEmbed} style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
        <div class="venue-copy">
          <p class="eyebrow">El lugar</p>
          <h2>San Angelo Zafiro<br /><em>Salón VIP</em></h2>
          <address>Avenida 33 # 80c - 30<br />Medellín</address>
          <a class="button" href={mapUrl} target="_blank" rel="noreferrer">Cómo llegar <span>↗</span></a>
        </div>
      </section>

      <section class="details section">
        <div class="bf-field bf-field-quiet" data-butterfly-zone="details" aria-hidden="true">
          <span class="bf bf-gold bf-c"></span>
          <span class="bf bf-blue bf-a"></span>
        </div>
        <p class="eyebrow">Detalles de la noche</p>
        <h2 class="details-title">Todo pensado para<br /><em>celebrar juntos.</em></h2>
        <div class="detail-grid">
          <article><span class="detail-symbol">✦</span><h3>Código de<br /><em>vestimenta</em></h3><p><strong>Tipo cóctel</strong><br />Reservamos el color <span class="reserved-colors"><span class="gold-word">dorado</span> y <span class="blue-word">azul</span></span> para la quinceañera.</p></article>
          <article><span class="detail-symbol">♡</span><h3>Mesa de<br /><em>regalos</em></h3><p><strong>Lluvia de sobres</strong><br />Tu presencia será nuestro regalo más bonito.</p></article>
        </div>
      </section>

      <section class="rsvp section">
        <div class="bf-field bf-field-quiet" data-butterfly-zone="rsvp" aria-hidden="true">
          <span class="bf bf-blue bf-d"></span>
          <span class="bf bf-gold bf-b"></span>
        </div>
        <p class="eyebrow">Confirma tu asistencia</p>
        <h2>¿Nos<br /><em>acompañas?</em></h2>
        <p>Por favor confirma antes del <strong>6 de febrero de 2027</strong>.</p>
        <p class="cupos-note" data-cupos-note hidden></p>

        <div class="confirm-note" role="note">
          <strong>Confirma tu asistencia para asegurar tu lugar</strong>
          <span>Así podremos tener todo preparado y esperarte como te mereces.</span>
        </div>

        <div class="actions">{phoneNumbers.map((phone) => <a class="button button-light rsvp-link" data-phone={phone} href={`https://wa.me/${phone}?text=${message}`} target="_blank" rel="noreferrer">Confirmar por WhatsApp ↗</a>)}</div>
      </section>

      <section class="gallery section">
        <p class="eyebrow">Recuerdos</p>
        <h2 class="gallery-heading">Momentos que<br /><em>nos unen.</em></h2>
        <div class="gallery-track">
          {photos.map((photo, i) => (
            <div class="gallery-item" role="button" tabindex="0" aria-label={`Ver foto ${i + 1}`}
              data-symbol={['♡', '✦', '◇', '✿', '❋', '✧'][i]}>
              <img src={photo.src} alt={photo.alt} loading="lazy" onerror="this.style.display='none'" />
            </div>
          ))}
        </div>
        <div class="gallery-dots">
          {photos.map((_, i) => (
            <span class:list={['gallery-dot', { active: i === 0 }]} data-dot={i}></span>
          ))}
        </div>
      </section>

      <div class="lightbox" role="dialog" aria-label="Visor de fotos" hidden>
        <button class="lightbox-close" aria-label="Cerrar">&times;</button>
        <img class="lightbox-img" src="" alt="" />
      </div>

      <footer>
        <p class="hashtag">#Mis15Danna · #DANNAXV</p>
        <div class="bf-field bf-field-quiet" data-butterfly-zone="footer" aria-hidden="true">
          <span class="bf bf-gold bf-b" style="--x:44%;--y:38%;--s:26px;--dur:6s;--delay:0.8s"></span>
        </div>
        <p class="footer-name">Danna Stefania · XV</p>
      </footer>
    </main>

    <script is:inline>
      const countdown = document.querySelector('[data-countdown]');
      const tick = () => { const diff = Math.max(0, new Date(countdown.dataset.target).getTime() - Date.now()); const values = [Math.floor(diff / 86400000), Math.floor(diff / 3600000) % 24, Math.floor(diff / 60000) % 60, Math.floor(diff / 1000) % 60]; ['days','hours','minutes','seconds'].forEach((key, i) => document.querySelector(`[data-${key}]`).textContent = String(values[i]).padStart(2, '0')); };
      tick(); setInterval(tick, 1000);
    </script>
    <script>
      const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
      const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
      const token = new URLSearchParams(window.location.search).get('invitacion');

      const TITLE_PARTICLES = new Set(['de', 'del', 'la', 'las', 'los', 'y', 'e', 'o', 'u', 'a', 'al']);
      const toTitleCase = (value: string): string =>
        value
          .trim()
          .toLowerCase()
          .split(/\s+/)
          .map((word, index) =>
            index > 0 && TITLE_PARTICLES.has(word)
              ? word
              : word.charAt(0).toUpperCase() + word.slice(1),
          )
          .join(' ');

      const cleanFamilyName = (rawName: string): string =>
        rawName
          .replace(/^(FLIA|FAMILIA)\s+/i, '')
          .replace(/\s+(Y\s+)?(FLIA|FAMILIA)\s*$/i, '')
          .trim();

      const buildSalutation = (
        displayName: string,
        rawName: string,
        treatment: string | null,
      ): string => {
        const looksLikeFamily = /^(FLIA|FAMILIA)\b|\bY\s+(FLIA|FAMILIA)\b/i.test(rawName);
        if (treatment === 'fam' || (!treatment && looksLikeFamily)) {
          return `Querida familia ${toTitleCase(cleanFamilyName(rawName))}:`;
        }
        if (treatment === 'd') return `Querido ${displayName}:`;
        if (treatment === 'grupo') return `Queridos ${displayName}:`;
        return `Querida ${displayName}:`;
      };

      const applyGuestPersonalization = async () => {
        if (!token || !supabaseUrl || !supabaseAnonKey) return;
        const dedication = document.querySelector<HTMLElement>('[data-guest-dedication]');
        const salutation = document.querySelector<HTMLElement>('[data-guest-salutation]');
        const cuposNote = document.querySelector<HTMLElement>('[data-cupos-note]');
        const rsvpLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.rsvp-link'));
        if (!dedication || !salutation || rsvpLinks.length === 0) return;
        try {
          const { createClient } = await import('@supabase/supabase-js');
          const supabase = createClient(supabaseUrl, supabaseAnonKey);
          const { data, error } = await supabase.rpc('get_guest_rsvp', { p_token: token });
          if (error || !Array.isArray(data) || data.length !== 1) return;
          const row = data[0];
          if (!row || row.slug !== 'danna-xv' || !row.guest_name) return;
          const rawName = String(row.guest_name);
          const displayName = toTitleCase(rawName);
          const treatment = typeof row.treatment === 'string' ? row.treatment : null;
          dedication.textContent = `para ${displayName}`;
          dedication.hidden = false;
          salutation.textContent = buildSalutation(displayName, rawName, treatment);
          salutation.hidden = false;
          if (cuposNote && typeof row.cupos === 'number' && row.cupos > 0) {
            const isGroup = treatment === 'fam' || treatment === 'grupo';
            const noun = row.cupos === 1 ? 'cupo' : 'cupos';
            cuposNote.textContent = isGroup
              ? `Reservamos ${row.cupos} ${noun} para ustedes`
              : `Reservamos ${row.cupos} ${noun} para ti`;
            cuposNote.hidden = false;
          }
          const encodedName = encodeURIComponent(displayName);
          rsvpLinks.forEach((link) => {
            link.href = link.href.replace('%5BTu%20nombre%5D', encodedName);
          });
        } catch {
          return;
        }
      };

      applyGuestPersonalization();
    </script>
    <script is:inline>
      const lightbox = document.querySelector('.lightbox');
      const lightboxImg = document.querySelector('.lightbox-img');
      const closeLightbox = () => { lightbox.hidden = true; lightbox.classList.remove('active'); };
      document.querySelectorAll('.gallery-item').forEach(item => {
        item.addEventListener('click', () => {
          const img = item.querySelector('img');
          lightboxImg.src = img.src; lightboxImg.alt = img.alt;
          lightbox.hidden = false; lightbox.classList.add('active');
        });
        item.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); item.click(); } });
      });
      document.querySelector('.lightbox-close').addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lightbox.hidden) closeLightbox(); });
      const galleryObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('visible'); galleryObserver.unobserve(entry.target); } });
      }, { threshold: 0.15 });
      document.querySelectorAll('.gallery-item').forEach((item, i) => { item.style.setProperty('--d', `${i * .08}s`); galleryObserver.observe(item); });
      const track = document.querySelector('.gallery-track');
      const dots = document.querySelectorAll('.gallery-dot');
      const items = document.querySelectorAll('.gallery-item');
      const updateDots = () => {
        const scrollLeft = track.scrollLeft;
        const trackWidth = track.scrollWidth - track.clientWidth;
        const progress = trackWidth > 0 ? scrollLeft / trackWidth : 0;
        const active = Math.round(progress * (items.length - 1));
        dots.forEach((d, i) => d.classList.toggle('active', i === active));
      };
      track.addEventListener('scroll', updateDots, { passive: true });
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          items[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        });
      });
    </script>
    <script is:inline>
      // 🦋 Mariposas SVG con silueta, manchas y aleteo real en 3D.
      // Cada ala es su propio <svg> para que perspective + rotateY funcionen
      // en todos los navegadores, sin convertirlas en simples hojas.
      const BUTTERFLY_SVG = (gold) => {
        const wings = gold ? 'url(#bf-gold-grad)' : 'url(#bf-blue-grad)';
        const spots = gold ? '#fff4d7' : '#d8edff';
        const veins = gold ? '#a8752f' : '#315e91';
        const outline = gold ? '#8d642d' : '#1d416d';
        const body = gold ? '#b98a3f' : '#0e2747';
        const ant = gold ? '#c89a4a' : '#9cc3ea';
        return `
        <svg class="bf-wing bf-wing-l" viewBox="0 0 50 82" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path fill="${wings}" stroke="${outline}" stroke-width="1.4" stroke-linejoin="round" d="M50 42 C 46 28, 37 10, 20 8 C 7 7, 1 17, 4 30 C 7 44, 19 49, 39 48 C 25 51, 13 58, 14 70 C 26 71, 40 61, 50 50 Z"/>
          <path fill="${spots}" d="M21 18 C 14 17, 10 22, 12 28 C 14 33, 20 34, 26 30 C 28 25, 26 20, 21 18 Z" opacity=".9"/>
          <path fill="${spots}" d="M29 42 C 23 39, 18 42, 18 47 C 20 51, 27 52, 33 48 Z" opacity=".75"/>
          <path fill="none" stroke="${veins}" stroke-width="1.2" stroke-linecap="round" d="M47 43 C 34 34, 25 22, 18 12 M47 44 C 34 42, 22 38, 9 31 M47 48 C 34 53, 25 61, 17 69" opacity=".7"/>
        </svg>
        <svg class="bf-wing bf-wing-r" viewBox="0 0 50 82" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path fill="${wings}" stroke="${outline}" stroke-width="1.4" stroke-linejoin="round" d="M0 42 C 4 28, 13 10, 30 8 C 43 7, 49 17, 46 30 C 43 44, 31 49, 11 48 C 25 51, 37 58, 36 70 C 24 71, 10 61, 0 50 Z"/>
          <path fill="${spots}" d="M29 18 C 36 17, 40 22, 38 28 C 36 33, 30 34, 24 30 C 22 25, 24 20, 29 18 Z" opacity=".9"/>
          <path fill="${spots}" d="M21 42 C 27 39, 32 42, 32 47 C 30 51, 23 52, 17 48 Z" opacity=".75"/>
          <path fill="none" stroke="${veins}" stroke-width="1.2" stroke-linecap="round" d="M3 43 C 16 34, 25 22, 32 12 M3 44 C 16 42, 28 38, 41 31 M3 48 C 16 53, 25 61, 33 69" opacity=".7"/>
        </svg>
        <svg class="bf-body" viewBox="0 0 100 82" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="50" cy="35" r="3.2" fill="${body}"/>
          <path d="M49 36 Q51 52 50 68 Q49 76 50 78 Q51 76 50 68 Q49 52 51 36 Z" fill="${body}" stroke="${outline}" stroke-width="1"/>
          <path d="M48 35 Q42 26 35 25 M52 35 Q58 26 65 25" fill="none" stroke="${ant}" stroke-width="1.8" stroke-linecap="round"/>
        </svg>`;
      };
      document.querySelectorAll('.bf').forEach((el) => {
        el.innerHTML = BUTTERFLY_SVG(el.classList.contains('bf-gold'));
      });

      // Repartición orgánica pero estable: cambia por zona, no en cada frame.
      // Así cada visita conserva una composición bonita y las mariposas no
      // caen encima del nombre, las tarjetas, el mapa o el botón de RSVP.
      const zoneSeed = (text) => [...text].reduce((sum, char) => sum + char.charCodeAt(0), 0);
      const random01 = (seed) => {
        const value = Math.sin(seed * 12.9898) * 43758.5453;
        return value - Math.floor(value);
      };
      // Vuelo orgánico: cada mariposa combina un revoloteo rápido con una
      // deriva lenta e irregular, de modo que el patrón nunca se repite igual.
      const flock = [];
      document.querySelectorAll('[data-butterfly-zone]').forEach((field, zoneIndex) => {
        const zone = field.dataset.butterflyZone || 'zone';
        const edgeSeed = zoneSeed(zone) + zoneIndex * 31;
        field.querySelectorAll('.bf').forEach((butterfly, index) => {
          const r = (offset) => random01(edgeSeed + index * 17 + offset);
          // Repartición amplia: no quedan encerradas en los costados.
          // La opacidad baja y el z-index posterior mantienen el contenido legible.
          const x = 7 + r(1) * 86;
          const y = 9 + r(3) * 78;
          butterfly.style.setProperty('--x', `${x.toFixed(1)}%`);
          butterfly.style.setProperty('--y', `${y.toFixed(1)}%`);
          butterfly.style.setProperty('--s', `${24 + Math.round(r(4) * 28)}px`);
          butterfly.style.setProperty('--opacity', `${(0.42 + r(7) * 0.26).toFixed(2)}`);
          flock.push({
            el: butterfly,
            field,
            // Revoloteo suave: amplitudes pequeñas y frecuencias moderadas
            flapAmpX: (0.012 + r(9) * 0.018),
            flapAmpY: (0.012 + r(10) * 0.018),
            f1: 0.7 + r(11) * 0.9,
            f2: 1.3 + r(12) * 1.3,
            // Deriva lenta y uniforme: planea por la sección sin prisas
            driftAmpX: (0.05 + r(13) * 0.07),
            driftAmpY: (0.045 + r(14) * 0.06),
            f3: 0.03 + r(15) * 0.045,
            phase: r(16) * Math.PI * 2,
            tilt: (r(17) - 0.5) * 8,
            speed: 0.55 + r(18) * 0.55,
            t: r(19) * 20,
          });
        });
      });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let last = performance.now();
      const flyFrame = (now) => {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        for (const b of flock) {
          b.t += dt * b.speed;
          const t = b.t;
          const w = b.field.clientWidth || 1;
          const h = b.field.clientHeight || 1;
          // Revoloteo: oscilaciones suaves superpuestas (más peso al componente lento)
          const rx = (Math.sin(t * b.f1 + b.phase) * 0.7 + Math.sin(t * b.f2 * 1.31 + b.phase * 2.7) * 0.3) * b.flapAmpX * w;
          const ry = (Math.cos(t * b.f2 + b.phase * 1.7) * 0.7 + Math.sin(t * b.f1 * 0.93 + b.phase * 3.1) * 0.3) * b.flapAmpY * h;
          // Deriva: viaje lento por la sección, con giros suaves
          const dx = Math.sin(t * b.f3) * b.driftAmpX * w;
          const dy = Math.cos(t * b.f3 * 0.83 + b.phase) * b.driftAmpY * h;
          const rot = b.tilt + Math.sin(t * b.f1 * 1.8 + b.phase) * 3.5;
